{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "世界": {
      "default": {},
      "type": "object",
      "properties": {
        "当前时间": {
          "description": "格式：西历YYYY年·月·日|时辰",
          "$ref": "#/$defs/__schema0"
        },
        "当前地点": {
          "description": "格式：大地域|小地点",
          "$ref": "#/$defs/__schema1"
        },
        "当前国家": {
          "default": "圣罗兰帝国",
          "type": "string"
        },
        "已游历地域": {
          "default": {
            "圣罗兰帝国·王都": "西历1024年·霜月·初三"
          },
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "地域名"
          },
          "additionalProperties": {
            "description": "首次到达日期",
            "$ref": "#/$defs/__schema2"
          }
        },
        "金币": {
          "default": 1000000,
          "type": "number"
        },
        "声望": {
          "default": 20,
          "type": "number"
        },
        "家族资源": {
          "default": {
            "魔晶矿": {
              "描述": "蕴含纯净魔力的深紫结晶，家族私矿年产万斤，富可敌国",
              "数量": 9999
            },
            "生命灵药": {
              "描述": "延年益寿的金色药液，连王室也难得一见",
              "数量": 50
            },
            "远古宝藏": {
              "描述": "历代先祖从大陆遗迹中搜罗的奇珍异宝",
              "数量": 1
            },
            "商会股份": {
              "描述": "横跨数国的贸易航线与钱庄控股权",
              "数量": 12
            }
          },
          "type": "object",
          "propertyNames": {
            "type": "string",
            "description": "资源名"
          },
          "additionalProperties": {
            "default": {},
            "type": "object",
            "properties": {
              "描述": {
                "default": "家族珍藏",
                "type": "string"
              },
              "数量": {
                "default": 1,
                "type": "number"
              }
            }
          }
        }
      }
    },
    "主角": {
      "default": {},
      "type": "object",
      "properties": {
        "姓名": {
          "default": "{{user}}",
          "type": "string"
        },
        "性别": {
          "default": "男",
          "type": "string",
          "enum": [
            "男",
            "女",
            "其他"
          ]
        },
        "年龄": {
          "default": 19,
          "type": "number"
        },
        "头衔": {
          "default": "白蔷薇公爵独子 · 圣罗兰帝国第一顺位继承人",
          "type": "string"
        },
        "家族": {
          "default": "白蔷薇家族",
          "type": "string"
        },
        "财富等级": {
          "default": "极富（大陆顶端）",
          "type": "string"
        },
        "当前着装": {
          "default": "裁剪考究的银白丝绒礼服，肩披绣有白蔷薇家徽的披风，腰悬镶嵌魔晶的长剑",
          "type": "string"
        },
        "当前姿势": {
          "default": "端坐于王宫书房，指尖轻敲扶手",
          "type": "string"
        },
        "当前想法": {
          "default": "大陆广袤，佳丽如云；是时候启程环游，将天下美人尽收后宫了。",
          "type": "string"
        },
        "射精进度": {
          "default": 0,
          "type": "number"
        }
      }
    },
    "后宫": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "description": "角色全名"
      },
      "additionalProperties": {
        "default": {},
        "type": "object",
        "properties": {
          "年龄": {
            "default": 18,
            "type": "number"
          },
          "种族身份": {
            "default": "未登记",
            "type": "string"
          },
          "关系": {
            "default": "未登记",
            "type": "string"
          },
          "好感度": {
            "default": 20,
            "type": "number"
          },
          "当前着装": {
            "default": "未描述",
            "type": "string"
          },
          "当前姿势": {
            "default": "未描述",
            "type": "string"
          },
          "当前位置": {
            "default": "未知",
            "type": "string"
          },
          "当前想法": {
            "default": "她还没有说出此刻的想法",
            "type": "string"
          },
          "处女": {
            "default": true,
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "enum": [
                  "true",
                  "false",
                  "是",
                  "否"
                ]
              }
            ]
          },
          "破处记录": {
            "default": "无",
            "type": "string"
          },
          "最近性行为": {
            "default": "无",
            "type": "string"
          },
          "胸部状态": {
            "default": "乳房处于自然状态，未充血",
            "type": "string"
          },
          "阴部状态": {
            "default": "干燥状态",
            "type": "string"
          },
          "身体状态": {
            "default": "健康状态良好",
            "type": "string"
          },
          "高潮次数": {
            "default": 0,
            "type": "number"
          },
          "被内射次数": {
            "default": 0,
            "type": "number"
          },
          "外貌信息": {
            "default": {},
            "type": "object",
            "properties": {
              "脸型": {
                "description": "固定外貌：脸型，如 鹅蛋脸",
                "$ref": "#/$defs/__schema3"
              },
              "发型": {
                "description": "固定外貌：发型与发色，如 银色长发垂至腰际",
                "$ref": "#/$defs/__schema4"
              },
              "眼睛": {
                "description": "固定外貌：眼睛形状与瞳色，如 琥珀色竖瞳",
                "$ref": "#/$defs/__schema5"
              },
              "气质": {
                "description": "固定外貌：整体气质，如 清冷如月",
                "$ref": "#/$defs/__schema6"
              },
              "五官": {
                "description": "固定外貌：鼻/唇/齿等五官细节",
                "$ref": "#/$defs/__schema7"
              }
            }
          },
          "身材信息": {
            "default": {},
            "type": "object",
            "properties": {
              "身高": {
                "description": "固定身材设定：身高，如 158cm",
                "$ref": "#/$defs/__schema8"
              },
              "体重": {
                "description": "固定身材设定：体重，如 46kg",
                "$ref": "#/$defs/__schema9"
              },
              "体型": {
                "description": "固定身材设定：体型，如 娇小玲珑/丰满婀娜/健美有力",
                "$ref": "#/$defs/__schema10"
              },
              "三围": {
                "description": "固定身材设定：三围，如 B82/W56/H84",
                "$ref": "#/$defs/__schema11"
              },
              "乳": {
                "description": "固定身材设定：乳房罩杯与外观",
                "$ref": "#/$defs/__schema12"
              },
              "腰": {
                "description": "固定身材设定：腰肢描述",
                "$ref": "#/$defs/__schema13"
              },
              "臀": {
                "description": "固定身材设定：臀部描述",
                "$ref": "#/$defs/__schema14"
              },
              "腿": {
                "description": "固定身材设定：腿部描述",
                "$ref": "#/$defs/__schema15"
              },
              "穴": {
                "description": "固定身材设定：阴部外观",
                "$ref": "#/$defs/__schema16"
              },
              "皮肤": {
                "description": "固定身材设定：肤质描述",
                "$ref": "#/$defs/__schema17"
              },
              "体味": {
                "description": "固定身材设定：体味描述",
                "$ref": "#/$defs/__schema18"
              }
            }
          }
        }
      }
    },
    "行动选项": {
      "default": {},
      "type": "object",
      "properties": {
        "当前视角": {
          "default": "{{user}}",
          "type": "string"
        },
        "选项一": {
          "default": "在王都举办启程宴会，邀请名流贵女",
          "type": "string"
        },
        "选项二": {
          "default": "先去精灵森林，传闻那里的精灵公主倾国倾城",
          "type": "string"
        },
        "选项三": {
          "default": "检阅家族商队，筹备环游大陆的物资",
          "type": "string"
        },
        "选项四": {
          "default": "夜探王都灯会，或许能撞见一段艳遇",
          "type": "string"
        }
      }
    },
    "事件": {
      "default": [
        "西历1024年·霜月·初三|白蔷薇宫|主角决定启程环游大陆，广纳后宫"
      ],
      "type": "array",
      "items": {
        "description": "日期|地点|事件描述",
        "$ref": "#/$defs/__schema19"
      }
    }
  },
  "$defs": {
    "__schema0": {
      "default": "西历1024年·霜月·初三|辰时",
      "type": "string"
    },
    "__schema1": {
      "default": "圣罗兰帝国·王都|白蔷薇宫",
      "type": "string"
    },
    "__schema2": {
      "default": "西历1024年·霜月·初三",
      "type": "string"
    },
    "__schema3": {
      "default": "鹅蛋脸",
      "type": "string"
    },
    "__schema4": {
      "default": "乌黑长发垂至腰际",
      "type": "string"
    },
    "__schema5": {
      "default": "茶色杏眼",
      "type": "string"
    },
    "__schema6": {
      "default": "温婉可人",
      "type": "string"
    },
    "__schema7": {
      "default": "鼻梁秀挺，菱唇粉嫩",
      "type": "string"
    },
    "__schema8": {
      "default": "158cm",
      "type": "string"
    },
    "__schema9": {
      "default": "46kg",
      "type": "string"
    },
    "__schema10": {
      "default": "娇小玲珑",
      "type": "string"
    },
    "__schema11": {
      "default": "B82/W56/H84",
      "type": "string"
    },
    "__schema12": {
      "default": "B罩杯，匀称娇挺，乳晕淡粉",
      "type": "string"
    },
    "__schema13": {
      "default": "纤细柔韧，不盈一握",
      "type": "string"
    },
    "__schema14": {
      "default": "小巧圆润，线条柔和",
      "type": "string"
    },
    "__schema15": {
      "default": "笔直匀称，白皙细腻",
      "type": "string"
    },
    "__schema16": {
      "default": "一线天，粉嫩紧致",
      "type": "string"
    },
    "__schema17": {
      "default": "欺霜赛雪，温润细腻",
      "type": "string"
    },
    "__schema18": {
      "default": "淡淡皂香，清甜",
      "type": "string"
    },
    "__schema19": {
      "default": "",
      "type": "string"
    }
  }
}