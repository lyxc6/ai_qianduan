变量更新规则:
  世界:
    时间:
      type: string
      格式: "永恒历YYYY年MM月DD日 HH:mm"
      check: "根据剧情发展推进时间，事件发生时更新。正常对话推进约15-30分钟，重大事件可能跨越数小时"
    地点:
      type: string
      check: "根据角色移动和事件发生地点更新。保持与当前场景一致"
  主角:
    姓名:
      type: string
      check: "固定为用户角色名，不应更改"
    年龄:
      type: number
      范围: "18-100"
      check: "除非发生重大时间跳跃，否则不更新"
    力量等级:
      type: string
      check: "除非获得新能力或突破境界，否则不更新。参考：传奇级（等级五）、史诗级（等级四）、精英级（等级三）、熟练级（等级二）、入门级（等级一）"
    当前着装:
      type: string
      check: "根据场景变化和玩家行为更新。入睡后可能穿着睡袍，训练时可能穿着训练服，出访时可能穿着正装"
    当前姿势:
      type: string
      check: "根据当前动作和场景更新，如'坐起身'、'站立'、'行走'、'跪下'等"
    当前位置:
      type: string
      check: "应与世界.地点基本一致，具体到房间或场所名称"
    当前想法:
      type: string
      check: "根据当前情境、近期事件、角色关系变化反映主角的心理状态和关注点"
    最近性行为:
      type: string
      格式: "时间, 地点, 体位"
      check: "每次发生性行为后更新。记录最近一次的时间（精确到日）、地点和主要体位"
  角色:
    角色名:
      年龄:
        type: number
        范围: "18-50"
        check: "除非发生重大时间跳跃，否则不更新"
      处女:
        type: string
        check: "是 或 否"
      力量等级:
        type: string
        check: "根据训练和实战经历可能提升。参考：传奇级、史诗级、精英级、熟练级、入门级"
      好感度:
        type: number
        范围: "0-100"
        check: |
          根据以下因素调整：
          - 尊重和温柔对待：+3~6
          - 冷落或粗暴对待：-5~10
          - 亲密行为（视具体情况）：+2~5
          - 重要的纪念日或惊喜：+5~10
          - 背叛或出轨行为：-20~-50
          - 作为正妻被重视和陪伴：+5~10
      后宫地位:
        type: string
        check: "固定词条，除非发生特殊剧情变化"
      当前着装:
        type: string
        check: "根据场景和时间更新。如清晨可能穿着睡袍，工作时穿着管家服，出访时穿着正装"
      当前姿势:
        type: string
        check: "反映当前正在进行的动作，如'梳理长发'、'整理文件'、'躬身行礼'等"
      当前想法:
        type: string
        check: "反映对领主、家庭事务、后宫关系等的想法，应体现正妻的责任感和对领主的爱慕"
      最近性行为:
        type: string
        check: "每次与领主发生性行为后更新。记录最近一次的时间（精确到日）、地点和主要体位"
      当前小穴状态:
        type: string
        check: |
          根据以下状态更新：
          - 正常状态：未发生性行为或性行为后已恢复
          - 略微湿润：性兴奋或性行为前戏阶段
          - 高潮后红肿：性行为刚结束后
          - 敏感状态：性高潮后短时间内
          - 经期状态：月经期间
      当前胸部状态:
        type: string
        check: |
          根据以下状态更新：
          - 乳房柔软，乳尖微微挺立：正常状态或刚睡醒
          - 乳房因兴奋硬挺：性兴奋状态
          - 有吻痕或咬痕：性行为后
          - 乳房胀满：可能怀孕或月经前
      月经状态:
        type: string
        格式: "月经周期第X天（状态描述）"
        check: |
          根据真实生理周期（约28天）更新：
          - 第1-7天：月经期
          - 第8-14天：排卵期前
          - 第15天左右：排卵期
          - 第16-28天：安全期/黄体期
          每月约推进3-5天（取决于剧情时间跨度）
      怀孕状态:
        type: string
        check: "描述当前是否怀孕，如'未怀孕'、'已怀孕'、'已分娩'等"
      性爱次数:
        type: number
        范围: "0-无上限"
        check: "每次发生性行为后+1"
  最近事件:
    check: "记录最近发生的事件，包括重大事件、日常事件等"
    事件:
      时间:
        type: string
        check: "记录事件发生的时间（精确到日）"
      地点:
        type: string
        check: "记录事件发生的地点（如房间、场所名称）"
      内容:
        type: string
        check: "详细描述事件发生的具体情况，包括主角的行为、角色的反应等"
  破处事件:
    check: "当发生女性破处事件时候记录"
    事件:
      时间:
        type: string
        check: "记录事件发生的时间（精确到日）"
      地点:
        type: string
        check: "记录事件发生的地点（如房间、场所名称）"
      内容:
        type: string
        check: "详细描述事件发生的具体情况，包括主角的行为、角色的反应等"
