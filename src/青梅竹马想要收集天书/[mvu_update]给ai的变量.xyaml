<%
    try {
        const keywords = [
            { trigger: ["百毒真经", "毒经", "万毒经"], book: "天书：《百毒真经》" },
            { trigger: ["天道经", "道德经", "逆道经"], book: "天书：《天道经》" },
            { trigger: ["金刚经", "金刚怒", "金刚护体经"], book: "天书：《金刚护体经》" },
            { trigger: ["素女经", "合欢经", "阴阳和合经"], book: "天书：《阴阳和合经》" },
            { trigger: ["奇诡真经", "天魔策", "血魔策"], book: "天书：《奇诡真经》" },
            { trigger: ["西域真经", "昆仑经", "沙魔经"], book: "天书：《西域真经》" },
            { trigger: ["龙力真经", "降龙经", "噬龙经"], book: "天书：《龙力真经》" },
            { trigger: ["九剑真经", "剑经", "魔剑经"], book: "天书：《九剑真经》" },
            { trigger: ["点苍经", "蛊剑经", "南疆剑经"], book: "天书：《南疆剑经》" },
            { trigger: ["东海", "东海州", "泉州", "宁波", "琉球", "福州", "厦门", "潮州", "海口", "三亚", "湄洲", "澎湖", "海沙帮", "巨鲸帮", "蓬莱剑派"], book: "九州：东海" },
            { trigger: ["中原", "中原州", "洛阳", "皇城", "开封", "长安", "邺城", "许昌", "荥阳", "河南府", "汝州", "燕京", "少林寺", "武当派", "华山派", "丐帮总舵"], book: "九州：中原" },
            { trigger: ["北疆", "北疆州", "燕京", "太原", "大同", "山海关", "锦州", "沈阳", "长春", "哈尔滨", "张家口", "崆峒派", "玄冥教"], book: "九州：北疆" },
            { trigger: ["南蛮", "南蛮州", "大理", "昆明", "桂林", "柳州", "梧州", "百色", "河池", "崇左", "贵州", "点苍派", "五毒教", "万兽门"], book: "九州：南蛮" },
            { trigger: ["岭南", "岭南州", "广州", "南宁", "琼州", "潮州", "汕头", "珠海", "深圳", "湛江", "钦州", "潮汕", "岭南温家", "百越族"], book: "九州：岭南" },
            { trigger: ["江南", "江南州", "苏州", "杭州", "扬州", "无锡", "常州", "镇江", "绍兴", "嘉兴", "湖州", "金陵", "青城派", "金钱帮"], book: "九州：江南" },
            { trigger: ["漠北", "漠北州", "呼和浩特", "包头", "草原王庭", "鄂尔多斯", "呼伦贝尔", "赤峰", "通辽", "锡林浩特", "山丹", "草原金帐", "狼族部落"], book: "九州：漠北" },
            { trigger: ["西域", "西域州", "敦煌", "楼兰", "龟兹", "吐鲁番", "哈密", "喀什", "和田", "阿克苏", "吐蕃", "昆仑派", "血刀门", "星宿派"], book: "九州：西域" },
            { trigger: ["西川", "西川州", "成都", "重庆", "汉中", "绵阳", "乐山", "宜宾", "泸州", "内江", "自贡", "剑门", "蜀山剑派", "唐门"], book: "九州：西川" },
            { trigger: ["丐帮", "天下第一大帮", "君山"], book: "宗门：丐帮" },
            { trigger: ["五毒教", "五毒岭", "用毒第一"], book: "宗门：五毒教" },
            { trigger: ["华山派", "华山", "五岳剑派"], book: "宗门：华山派" },
            { trigger: ["少林寺", "少林", "嵩山", "易筋经"], book: "宗门：少林寺" },
            { trigger: ["峨眉派", "峨眉", "郭襄", "金顶"], book: "宗门：峨眉派" },
            { trigger: ["日月神教", "日月教", "黑木崖", "葵花宝典"], book: "宗门：日月神教" },
            { trigger: ["昆仑派", "昆仑", "两仪剑法"], book: "宗门：昆仑派" },
            { trigger: ["武当派", "武当", "张三丰", "太极拳"], book: "宗门：武当派" },
            { trigger: ["点苍派", "点苍", "南疆剑术"], book: "宗门：点苍派" }
        ];
        
        for (const item of keywords) {
            if (matchChatMessages(item.trigger)) {
                print(await getwi(item.book));
                print('\n')
            }
        }
    } catch (e) {
        console.error("检测错误:", e);
    }
%>

<%
    const roles = variables.stat_data.当前场景角色
    for (const item of roles) {
        if (getwi(item)) {
            print(await getwi(item));
            print('\n')
        }
    }
%>
